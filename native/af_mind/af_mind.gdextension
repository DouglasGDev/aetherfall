; Passo 1 (c) do dossie 22 S5.1. So windows: o unico compilador medido nesta maquina e o
; MSVC do toolset 14.44.35207 (S12.1) e o build.bat produz um .dll. Nenhuma linha de
; native/ compila contra documentacao -- quem abrir o segundo comprador adiciona a chave.

[configuration]

entry_symbol = "af_mind_entry"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

windows.debug.x86_64 = "res://native/af_mind/bin/af_mind.dll"
windows.release.x86_64 = "res://native/af_mind/bin/af_mind.dll"
